{
  "manifest_version": 3,
  "name": "Firebase Token Puller",
  "version": "1.0.0",
  "description": "One-click pull of the Firebase Auth API key and refresh token, with copy buttons. Internal team tool.",
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pull Firebase Token",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
